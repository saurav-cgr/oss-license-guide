{
  "cases": [
    {
      "case_id": "apache-internal-use-001",
      "category": "apache_supported",
      "description": "Apache-2.0 component used internally, no distribution.",
      "request": {
        "expression": "Apache-2.0",
        "facts": {
          "action": "use",
          "distribution": false
        }
      },
      "expect": {
        "outcome": "Likely permitted under stated assumptions",
        "must_abstain": false,
        "expected_permission": {
          "text": "Permission to use Apache-2.0 under the stated scenario",
          "source_id": "spdx:Apache-2.0@3.24.0",
          "span_index": 13,
          "entailing": [
            "grant of copyright license",
            "irrevocable"
          ]
        }
      }
    },
    {
      "case_id": "apache-internal-modify-002",
      "category": "apache_supported",
      "description": "Apache-2.0 component modified but never distributed is outside the reviewed action set.",
      "request": {
        "expression": "Apache-2.0",
        "facts": {
          "action": "modify",
          "distribution": false
        }
      },
      "expect": {
        "must_abstain": true,
        "forbidden_outcomes": [
          "Likely permitted under stated assumptions",
          "Permitted with listed obligations"
        ]
      }
    },
    {
      "case_id": "apache-source-unmodified-public-003",
