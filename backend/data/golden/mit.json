{
  "cases": [
    {
      "case_id": "mit-internal-use-001",
      "category": "mit_supported",
      "description": "MIT component used internally, no distribution outside the organization.",
      "request": {
        "expression": "MIT",
        "facts": {
          "action": "use",
          "distribution": false
        }
      },
      "expect": {
        "outcome": "Likely permitted under stated assumptions",
        "must_abstain": false,
        "expected_permission": {
          "text": "Permission to use MIT under the stated scenario",
          "source_id": "spdx:MIT@3.24.0",
          "span_index": 2,
          "entailing": [
            "permission is hereby granted",
            "without restriction"
          ]
        }
      }
    },
    {
      "case_id": "mit-internal-modify-002",
      "category": "mit_supported",
      "description": "MIT component modified but never distributed is outside the reviewed action set.",
      "request": {
        "expression": "MIT",
        "facts": {
          "action": "modify",
          "distribution": false
        }
      },
      "expect": {
        "must_abstain": true,
        "forbidden_outcomes": [
          "Likely permitted under stated assumptions",
          "Permitted with listed obligations"
        ]
      }
    },
    {
      "case_id": "mit-source-unmodified-public-003",
      "category": "mit_supported",
      "description": "Unmodified MIT dependency redistributed in source form to the public.",
      "request": {
        "expression": "MIT",
        "facts": {
          "action": "redistribute",
          "distribution": true,
          "distribution_form": "source",
          "recipient": "public",
          "modified": false,
          "license_file_present": true,
          "copyright_notice_present": true,
          "notice_file_present": false
        }
      },
      "expect": {
        "outcome": "Permitted with listed obligations",
        "must_abstain": false,
        "expected_claims": [
          {
            "text": "Include the MIT license text",
            "source_id": "spdx:MIT@3.24.0",
            "span_index": 3,
            "entailing": [
              "included",
              "copies"
            ]
          },
          {
            "text": "Retain the original copyright notice",
            "source_id": "spdx:MIT@3.24.0",
            "span_index": 3,
            "entailing": [
              "copyright notice"
            ]
          }
        ]
      }
    },
