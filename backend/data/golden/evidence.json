{
  "cases": [
    {
      "case_id": "evidence-mit-source-001",
      "category": "conflicting_or_missing_evidence",
      "description": "MIT source redistribution must carry the license-text and notice spans in evidence.",
      "request": {
        "expression": "MIT",
        "facts": {
          "action": "redistribute",
          "distribution": true,
          "distribution_form": "source",
          "recipient": "public",
          "modified": false,
          "license_file_present": true,
          "copyright_notice_present": true,
          "notice_file_present": false
        }
      },
      "expect": {
        "outcome": "Permitted with listed obligations",
        "must_abstain": false,
        "required_citations": [
          {
            "source_id": "spdx:MIT@3.24.0",
            "span_index": 2
          },
          {
            "source_id": "spdx:MIT@3.24.0",
            "span_index": 3
          }
        ]
      }
    },
