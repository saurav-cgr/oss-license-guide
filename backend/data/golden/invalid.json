{
  "cases": [
    {
      "case_id": "invalid-trailing-or-001",
      "category": "invalid",
      "description": "A dangling OR operator must be rejected.",
      "request": {
        "expression": "MIT OR",
        "facts": { "action": "use", "distribution": false }
      },
      "expect": { "outcome": "Insufficient information", "must_abstain": true }
    },
    {
      "case_id": "invalid-leading-and-002",
      "category": "invalid",
      "description": "A leading AND operator must be rejected.",
      "request": {
        "expression": "AND MIT",
        "facts": { "action": "use", "distribution": false }
      },
      "expect": { "outcome": "Insufficient information", "must_abstain": true }
    },
    {
      "case_id": "invalid-empty-group-003",
      "category": "invalid",
      "description": "An empty group must be rejected.",
      "request": {
        "expression": "()",
        "facts": { "action": "use", "distribution": false }
      },
      "expect": { "outcome": "Insufficient information", "must_abstain": true }
    },
    {
      "case_id": "invalid-adjacent-ids-004",
      "category": "invalid",
