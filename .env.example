# Copy to .env and adjust for local development. Never commit .env.
#
# Comma-separated list of allowed CORS origins. Empty disables CORS.
OLG_CORS_ORIGINS=

# Comma-separated provider allowlist served by /api/v1/providers.
OLG_PROVIDERS_ENABLED=gemini,openai

# Server-controlled provider endpoints (never set by public requests).
OLG_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
OLG_OPENAI_ENDPOINT=https://api.openai.com/v1

# Development-only Gemini key. Uncommitted; leave empty in production and never
# enable OLG_ALLOW_DEV_PROVIDER_KEY on a public deployment.
OLG_GEMINI_API_KEY=
OLG_ALLOW_DEV_PROVIDER_KEY=false

# Bounded provider call limits.
OLG_PROVIDER_TIMEOUT_SECONDS=10
OLG_PROVIDER_MAX_TOKENS=600
OLG_PROVIDER_MAX_REPAIRS=1
OLG_PROVIDER_MAX_OUTPUT_CHARS=2000
